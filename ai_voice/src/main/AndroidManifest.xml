<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tuya.smart.ai_voice">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <activity
            android:name=".ui.AiVoiceHomeActivity"
            android:exported="false" />
        <activity
            android:name=".nativeui.NativeRecordActivity"
            android:exported="false" />
        <!-- 对话翻译（recordMode=3，手机麦）：从模式弹窗进入 -->
        <activity
            android:name=".nativeui.NativeFaceToFaceActivity"
            android:exported="false" />
        <!-- 灌流（音频注入）设置，从录音页顶栏进入 -->
        <activity
            android:name=".nativeui.NativeAudioInjectActivity"
            android:exported="false" />
        <!-- 灌流批量测试：多轮跑批 + WER + 报告导出 -->
        <activity
            android:name=".nativeui.NativeInjectBatchActivity"
            android:exported="false" />
        <activity
            android:name=".nativeui.NativeRecordListActivity"
            android:exported="false" />
        <activity
            android:name=".nativeui.NativeRecordDetailActivity"
            android:exported="false" />

        <!--
            Native 能力总入口：各模块演示页的唯一导航页，接入方从代码调
            NativeEntryActivity.start(context) 进入。
            exported 保持 false：这是一组调试页，没有理由允许其它应用拉起；
            接入方的正式包中也请移除对本组件的依赖。
        -->
        <activity
            android:name=".nativeui.NativeEntryActivity"
            android:exported="false" />
        <activity
            android:name=".nativeui.NativeOfflineFileActivity"
            android:exported="false" />
        <activity
            android:name=".nativeui.NativeAudioImportActivity"
            android:exported="false" />
        <activity
            android:name=".nativeui.NativeCloudSyncActivity"
            android:exported="false" />
        <activity
            android:name=".nativeui.NativeMergeRecordActivity"
            android:exported="false" />
        <activity
            android:name=".nativeui.NativeQuickEntryActivity"
            android:exported="false" />

        <!--
            导出转写文件用。转写文本先写进应用私有目录，再由 FileProvider 换成
            content:// URI 交给系统分享，全程不需要任何存储权限。
            复制 NativeRecordDetailActivity 的导出代码时，本节点与 @xml/native_file_paths 必须一并带走，
            否则运行到分享那步会直接抛 IllegalArgumentException。
            android:name 必须用自有子类：SDK 依赖里已声明过 androidx.core.content.FileProvider，
            再声明一次会合并失败，详见 TranscriptFileProvider 的类注释。
            authority 也特意加了 aivoice 段，避免与宿主应用已有的 provider 撞名。
        -->
        <provider
            android:name=".nativeui.widget.TranscriptFileProvider"
            android:authorities="${applicationId}.aivoice.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/native_file_paths" />
        </provider>
    </application>
</manifest>
