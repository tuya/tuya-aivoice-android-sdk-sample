<?xml version="1.0" encoding="utf-8"?><!--
  模块 2 · 转写 / 总结，Tab 版式（对齐 AI 笔记小程序的详情页）。

  结构：固定头部 + 固定 Tab 条 + 内容区。
  内容区三个容器靠 visibility 切换，各自带 ScrollView 独立滚动，
  因此本页 useScrollContainer() 返回 false，不用基类的滚动容器。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <!--
      标签（RecordTransferResultBean.tags）。变更由 onUpdateWitheTags 局部刷新；
      增删改入口在右上角「更多」里，本区只做展示。
    -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/native_detail_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        android:visibility="gone"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="4dp" />

    <!-- 上传进度：未开云同步时，转写前需先上传音频，进度由 ITransferListener 推送 -->
    <TextView
        android:id="@+id/native_detail_upload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        android:textColor="@color/ai_voice_tab_selected"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 固定 Tab 条 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/native_detail_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ai_voice_background"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/ai_voice_tab_selected"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/ai_voice_tab_selected"
        app:tabTextColor="@color/ai_voice_text_secondary" />

    <!-- 内容区：三个容器切 visibility -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 1 · 转写 -->
        <ScrollView
            android:id="@+id/native_detail_tab_transfer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 状态 + 参数 + 操作，构成「当前什么状态 + 能做什么」 -->
                <LinearLayout
                    android:id="@+id/native_detail_transfer_badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_native_status_gray"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/native_detail_transfer_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_native_status_dot"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/native_detail_transfer_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="@color/ai_voice_text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/native_detail_transfer_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_native_detail_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <CheckBox
                        android:id="@+id/native_detail_enable_speaker"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/native_detail_enable_speaker"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/native_detail_translate_lang"
                        style="@style/NativeInlineButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/native_detail_translate_lang_empty" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/native_detail_btn_transfer"
                        style="@style/NativeActionButton"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:text="@string/native_detail_gen_transfer" />
                </LinearLayout>

                <!--
                  正文只读：直接编辑这段可读文案无法安全映射回原始 JSON 结构。
                  两种转写模式统一用「长按 → 选一段 → 弹窗改」，见 pickSegmentToEdit()。
                -->
                <TextView
                    android:id="@+id/native_detail_transfer_text"
                    style="@style/NativeInfoBlock"
                    android:gravity="top"
                    android:minHeight="200dp"
                    android:textIsSelectable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/native_detail_transfer_edit_hint"
                    android:textColor="@color/ai_voice_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 2 · 总结 -->
        <ScrollView
            android:id="@+id/native_detail_tab_summary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/native_detail_summary_badge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_native_status_gray"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/native_detail_summary_dot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ic_native_status_dot"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/native_detail_summary_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:textColor="@color/ai_voice_text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/native_detail_summary_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_native_detail_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <Button
                        android:id="@+id/native_detail_template"
                        style="@style/NativeInlineButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="@string/native_detail_template_empty" />

                    <Button
                        android:id="@+id/native_detail_summary_lang"
                        style="@style/NativeInlineButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/native_detail_summary_lang_empty" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/native_detail_btn_summary"
                        style="@style/NativeActionButton"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:text="@string/native_detail_gen_summary" />

                    <Button
                        android:id="@+id/native_detail_btn_save_summary"
                        style="@style/NativeActionButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:text="@string/native_detail_save" />
                </LinearLayout>

                <!-- 只编辑 summary 正文；大纲与待办在「思维导图」Tab 里看 -->
                <EditText
                    android:id="@+id/native_detail_summary_text"
                    style="@style/NativeInfoBlock"
                    android:gravity="top"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine"
                    android:minHeight="200dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Tab 3 · 思维导图 -->
        <ScrollView
            android:id="@+id/native_detail_tab_mindmap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ai_voice_tag_bg"
                    android:padding="12dp"
                    android:text="@string/native_detail_mindmap_hint"
                    android:textColor="@color/ai_voice_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/native_detail_mindmap_json"
                    style="@style/NativeInfoBlock"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
