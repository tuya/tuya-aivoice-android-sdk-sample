<?xml version="1.0" encoding="utf-8"?>
<!-- 能力清单单项：标题 + 说明 + 涉及的 API 名 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_native_entry_item"
    android:baselineAligned="false"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_entry_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ai_voice_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_entry_arrow"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/native_api_entry_arrow"
            android:src="@drawable/ic_ai_arrow_right" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_entry_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ai_voice_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_entry_api"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ai_voice_tab_selected"
        android:textSize="11sp" />
</LinearLayout>
