<?xml version="1.0" encoding="utf-8"?>
<!-- 能力清单单项：标题 + 说明 + 涉及的 API 名 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/ai_voice_action_bg"
    android:baselineAligned="false"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_entry_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ai_voice_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_entry_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ai_voice_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_entry_api"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ai_voice_tab_selected"
        android:textSize="11sp" />
</LinearLayout>
