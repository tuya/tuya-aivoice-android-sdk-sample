<?xml version="1.0" encoding="utf-8"?>
<!-- 已选合并项：序号 + 文件名 + 上移/下移。顺序即音频拼接次序 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@color/ai_voice_action_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_index"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ai_voice_tab_selected"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/ai_voice_text_primary"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_up"
        style="@style/NativeInlineButton"
        android:layout_width="44dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/native_merge_move_up" />

    <Button
        android:id="@+id/btn_down"
        style="@style/NativeInlineButton"
        android:layout_width="44dp"
        android:layout_marginStart="4dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/native_merge_move_down" />
</LinearLayout>
