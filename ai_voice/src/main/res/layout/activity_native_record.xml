<?xml version="1.0" encoding="utf-8"?>
<!--
  录音控制页（录音室风格，与生产小程序 Simultaneous 容器同构）。
  模式由入口弹窗经 extra 锁定，本页没有模式切换 UI：
  - 白卡片：计时行（状态点 + 时长 + 设备能力）+ 内容区（音频模式=振幅波形 / 文字模式=转写流 / 空态提示）
    + 卡片底行（语言文字链 + TTS 开关，按模式显隐）
  - 底部控制条：设备切换入口 + 开始/暂停/继续大胶囊 + 完成
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_inject_banner"
        style="@style/NativeInfoBlock"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/ai_voice_action_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 计时行：状态点 + 时长 + 设备能力（模块 7） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/native_state_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_native_record_dot" />

                <TextView
                    android:id="@+id/native_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/native_duration_zero"
                    android:textColor="@color/ai_voice_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/native_device_ability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ai_voice_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 内容区：现场/电话=振幅波形；实时/同传=转写流；空闲=空态提示 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1">

                <com.tuya.smart.ai_voice.nativeui.widget.AmplitudeWaveView
                    android:id="@+id/native_wave"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <ScrollView
                    android:id="@+id/native_transcript_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/native_realtime_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/ai_voice_text_secondary"
                        android:textSize="15sp" />
                </ScrollView>

                <TextView
                    android:id="@+id/native_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textColor="@color/ai_voice_text_secondary"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- 卡片底行：语言链（点击弹语言选择）+ TTS 开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/native_lang_chain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/native_lang_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ai_voice_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/native_lang_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:text="→"
                        android:textColor="@color/ai_voice_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/native_lang_target"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ai_voice_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text=" ›"
                        android:textColor="@color/ai_voice_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/native_tts_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/ai_voice_tag_bg"
                    android:padding="6dp"
                    android:textColor="@color/ai_voice_tab_selected"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 底部控制条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/native_device_entry"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/native_device_id"
            android:padding="6dp"
            android:src="@drawable/ic_ai_device" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/native_capsule"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_native_record_capsule"
            android:gravity="center"
            android:text="@string/native_start"
            android:textColor="@color/ai_voice_text_primary"
            android:textSize="15sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/native_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="@string/native_record_done"
            android:textColor="@color/ai_voice_btn_disable"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
