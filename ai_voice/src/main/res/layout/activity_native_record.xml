<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_voice_background">

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/native_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/native_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/native_back"
            android:padding="8dp"
            android:src="@drawable/ic_ai_chevron_right"
            android:rotation="180" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/native_record_title"
            android:textColor="@color/ai_voice_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/native_top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ===== 配置区 ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/ai_voice_action_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 设备选择 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/native_device_id"
                        android:textColor="@color/ai_voice_text_secondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/native_device_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/ai_voice_divider" />

                    <!-- 当前选择摘要 -->
                    <TextView
                        android:id="@+id/native_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/ai_voice_tag_bg"
                        android:padding="10dp"
                        android:textColor="@color/ai_voice_text_primary"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/ai_voice_divider" />

                    <!-- 开关 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/native_opt_asr"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="@string/native_opt_asr"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/native_opt_amplitude"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="@string/native_opt_amplitude"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/native_opt_translate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="false"
                            android:text="@string/native_opt_translate"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- 语言 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/native_source_lang"
                                android:textColor="@color/ai_voice_text_secondary"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/native_source_lang"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/native_target_lang"
                                android:textColor="@color/ai_voice_text_secondary"
                                android:textSize="12sp" />

                            <Spinner
                                android:id="@+id/native_target_lang"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== 状态 + 振幅 ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/ai_voice_action_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/native_status"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/native_status_0"
                            android:textColor="@color/ai_voice_status_recording"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/native_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@color/ai_voice_text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.tuya.smart.ai_voice.ui.widget.AmplitudeWaveView
                        android:id="@+id/native_wave"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== 控制按钮 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/native_btn_start"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_native_btn_blue"
                    android:text="@string/native_start"
                    android:textColor="@color/ai_voice_text_on_card"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/native_btn_pause"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_native_btn_gray"
                    android:enabled="false"
                    android:text="@string/native_pause"
                    android:textColor="@color/ai_voice_text_on_card"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/native_btn_resume"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_native_btn_gray"
                    android:enabled="false"
                    android:text="@string/native_resume"
                    android:textColor="@color/ai_voice_text_on_card"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/native_btn_stop"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_native_btn_red"
                    android:enabled="false"
                    android:text="@string/native_stop"
                    android:textColor="@color/ai_voice_text_on_card"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/native_btn_switch_channel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_native_btn_outlined"
                android:enabled="false"
                android:text="@string/native_switch_channel"
                android:textColor="@color/ai_voice_card_blue"
                android:textSize="13sp" />

            <!-- ===== 实时转写 ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/ai_voice_action_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/native_realtime"
                        android:textColor="@color/ai_voice_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/native_realtime_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ai_voice_text_primary"
                            android:textColorHint="@color/ai_voice_text_secondary"
                            android:textIsSelectable="true"
                            android:textSize="14sp" />
                    </ScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ===== 日志 ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/ai_voice_action_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/native_log"
                        android:textColor="@color/ai_voice_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ScrollView
                        android:id="@+id/native_log_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/native_log_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/ai_voice_text_secondary"
                            android:textIsSelectable="true"
                            android:textSize="11sp" />
                    </ScrollView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
