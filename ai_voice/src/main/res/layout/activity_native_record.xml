<?xml version="1.0" encoding="utf-8"?>
<!--
  模块 1 · 录音控制 + 模块 7 · 设备能力。
  顶部栏与事件日志区由 NativeDemoBaseActivity 提供，此处仅内容区。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ===== 配置区 ===== -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ai_voice_action_bg"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 录音模式：决定 recordMode / needAsr / needTranslate / needAmplitude 的组合 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/native_record_mode"
                android:textColor="@color/ai_voice_text_secondary"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/native_record_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- 设备选择：决定 audioSource 的推导结果 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/native_device_id"
                android:textColor="@color/ai_voice_text_secondary"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/native_device_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <!-- 当前参数摘要 -->
            <TextView
                android:id="@+id/native_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/ai_voice_tag_bg"
                android:padding="10dp"
                android:textColor="@color/ai_voice_text_primary"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="8dp"
                android:background="@color/ai_voice_divider" />

            <!-- 高级：模式已给出默认组合，此处允许手动覆盖 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/native_advanced_section"
                android:textColor="@color/ai_voice_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/native_opt_asr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/native_opt_asr"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/native_opt_amplitude"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/native_opt_amplitude"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/native_opt_translate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/native_opt_translate"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- TTS：同传时把译文播回耳机 -->
            <CheckBox
                android:id="@+id/native_opt_tts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/native_opt_tts"
                android:textSize="13sp" />

            <!-- 语言 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/native_source_lang"
                        android:textColor="@color/ai_voice_text_secondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/native_source_lang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/native_target_lang"
                        android:textColor="@color/ai_voice_text_secondary"
                        android:textSize="12sp" />

                    <Spinner
                        android:id="@+id/native_target_lang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== 模块 7 · 设备能力状态条 ===== -->
    <TextView
        android:id="@+id/native_device_ability"
        style="@style/NativeInfoBlock"
        android:text="@string/native_ability_empty" />

    <!-- ===== 状态 + 振幅 ===== -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/ai_voice_action_bg"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/native_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/native_status_0"
                    android:textColor="@color/ai_voice_status_recording"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/native_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/native_duration_zero"
                    android:textColor="@color/ai_voice_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.tuya.smart.ai_voice.nativeui.widget.AmplitudeWaveView
                android:id="@+id/native_wave"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== 控制按钮 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/native_btn_start"
            style="@style/NativeActionButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/native_start" />

        <Button
            android:id="@+id/native_btn_pause"
            style="@style/NativeActionButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/native_pause" />

        <Button
            android:id="@+id/native_btn_resume"
            style="@style/NativeActionButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/native_resume" />

        <Button
            android:id="@+id/native_btn_stop"
            style="@style/NativeActionButtonDanger"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/native_stop" />
    </LinearLayout>

    <Button
        android:id="@+id/native_btn_switch_channel"
        style="@style/NativeActionButton"
        android:text="@string/native_switch_channel" />

    <!-- ===== 实时转写 ===== -->
    <TextView
        style="@style/NativeFieldLabel"
        android:text="@string/native_realtime" />

    <TextView
        android:id="@+id/native_realtime_text"
        style="@style/NativeInfoBlock"
        android:minHeight="120dp" />
</LinearLayout>
