<?xml version="1.0" encoding="utf-8"?>
<!-- 模块 4 · 离线文件传输：查询状态 → 开始/续传 → AP / BLE 通道切换 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/NativeSectionHint"
        android:text="@string/native_offline_hint" />

    <TextView
        style="@style/NativeFieldLabel"
        android:text="@string/native_offline_device" />

    <Spinner
        android:id="@+id/sp_device"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/ai_voice_action_bg" />

    <!-- 步骤 1：查询设备离线文件状态 -->
    <Button
        android:id="@+id/btn_query_status"
        style="@style/NativeActionButton"
        android:text="@string/native_offline_btn_query" />

    <TextView
        android:id="@+id/tv_status"
        style="@style/NativeInfoBlock"
        android:text="@string/native_offline_status_empty" />

    <!-- 步骤 2：发起 / 续传 -->
    <Button
        android:id="@+id/btn_load"
        style="@style/NativeActionButton"
        android:text="@string/native_offline_btn_load" />

    <!-- 步骤 3：AP / BLE 通道切换 -->
    <TextView
        style="@style/NativeFieldLabel"
        android:text="@string/native_offline_channel_section" />

    <TextView
        android:id="@+id/tv_channel"
        style="@style/NativeInfoBlock"
        android:text="@string/native_offline_channel_ble" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_switch_ap"
            style="@style/NativeActionButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/native_offline_btn_switch_ap" />

        <Button
            android:id="@+id/btn_switch_ble"
            style="@style/NativeActionButton"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/native_offline_btn_switch_ble" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_progress"
        style="@style/NativeInfoBlock"
        android:text="@string/native_offline_progress_empty" />
</LinearLayout>
