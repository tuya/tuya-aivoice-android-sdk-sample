<?xml version="1.0" encoding="utf-8"?>
<!-- 模块 9 · 快捷入口：查询添加状态 + 开关，另附两个 no-op 接口 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/NativeSectionHint"
        android:text="@string/native_quick_hint" />

    <Button
        android:id="@+id/btn_query_entry"
        style="@style/NativeActionButton"
        android:text="@string/native_quick_btn_query" />

    <LinearLayout
        android:id="@+id/ll_entry_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
