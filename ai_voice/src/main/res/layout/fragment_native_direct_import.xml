<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/NativeSectionHint"
        android:text="@string/native_import_direct_hint" />

    <Button
        android:id="@+id/btn_direct_import"
        style="@style/NativeActionButton"
        android:text="@string/native_import_btn_direct" />

    <Button
        android:id="@+id/btn_cancel_import"
        style="@style/NativeActionButtonDanger"
        android:text="@string/native_import_btn_cancel" />

    <TextView
        android:id="@+id/tv_import_status"
        style="@style/NativeInfoBlock"
        android:text="@string/native_import_status_empty" />

    <TextView
        style="@style/NativeFieldLabel"
        android:text="@string/native_import_failed_section" />

    <TextView
        android:id="@+id/tv_failed_files"
        style="@style/NativeInfoBlock"
        android:text="@string/native_import_failed_empty" />
</LinearLayout>
