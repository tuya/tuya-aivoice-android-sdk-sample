<?xml version="1.0" encoding="utf-8"?>
<!--
  Native 能力演示页统一脚手架布局。
  子类只提供内容区布局，由 NativeDemoBaseActivity 注入到 ll_content_container 中。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_voice_background"
    android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/native_back"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/ic_ai_chevron_right" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textColor="@color/ai_voice_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!--
      内容区根容器。基类按 useScrollContainer() 决定：
      true  → 先注入 layout_native_scroll_container，再把子类布局放进其中的 LinearLayout
      false → 子类布局直接填充本容器（列表类页面自行处理滚动）
    -->
    <FrameLayout
        android:id="@+id/fl_content_root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
