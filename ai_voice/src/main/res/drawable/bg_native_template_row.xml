<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ai_voice_tag_bg" />
            <stroke android:width="1dp" android:color="@color/ai_voice_card_blue" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ai_voice_action_bg" />
            <stroke android:width="1dp" android:color="@color/ai_voice_divider" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
