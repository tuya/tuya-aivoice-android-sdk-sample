    <!-- 更多 Native 能力清单 -->
    <string name="native_more_entry">更多能力</string>
    <string name="native_api_list_title">更多 Native 能力</string>
    <string name="native_api_list_hint">以下页面按 wearkit-ttt-native-api.md 的模块划分，每页独立演示一个模块的完整流程（含事件监听的注册与注销）。录音控制、设备能力见「Native 录音」，文件管理与转写总结见「录音列表」。</string>
    <string name="native_api_entry_offline_title">模块 4 · 离线文件传输</string>
    <string name="native_api_entry_offline_desc">把设备本地缓存的录音传到手机，支持 BLE 与 AP 快传两种通道</string>
    <string name="native_api_entry_offline_api">getDeviceOfflineFileStatus / loadOfflineFile / switchModeLoadOfflineFile / registerFileProgressCallback</string>
    <string name="native_api_entry_import_title">模块 5 · 音频导入</string>
    <string name="native_api_entry_import_desc">导入手机本地音频为录音记录，需在 onActivityResult 中回灌选择器结果</string>
    <string name="native_api_entry_import_api">startImport / retryImport / cancelImport / cancelRetry / handleImportActivityResult</string>
    <string name="native_api_entry_cloud_title">模块 6 · 云同步</string>
    <string name="native_api_entry_cloud_desc">云同步开关与上传下载聚合状态，Native 需自行聚合 SyncObserver 回调</string>
    <string name="native_api_entry_cloud_api">getCloudSyncSwitchStatus / syncNoteRecord / addAudioSyncObserver / addCloudSwitchListener</string>
    <string name="native_api_entry_merge_title">模块 8 · 合并录音</string>
    <string name="native_api_entry_merge_desc">按选定顺序把多条录音合并为一条，顺序决定音频拼接次序</string>
    <string name="native_api_entry_merge_api">mergeRecordList / cancelMergeRecordList / getFileMergeStatus / addMergeStatusListener</string>
    <string name="native_api_entry_quick_title">模块 9 · 快捷入口</string>
    <string name="native_api_entry_quick_desc">桌面小组件 / 快捷方式 / 磁贴的添加状态查询与开关</string>
    <string name="native_api_entry_quick_api">getQuickEntryList / setQuickEntryEnabled / addQuickEntryAddListener</string>
    <string name="native_api_entry_translate_title">模块 10 · 文本翻译（未实现）</string>
    <string name="native_api_entry_translate_desc">该模块属于 AI Translate 业务（businessType=1），AI 笔记小程序未使用，本 Demo 不实现</string>
    <string name="native_api_entry_translate_api">startTranslate / getTranslateFileList / sendToNote / batchRemoveTranslationFiles</string>

