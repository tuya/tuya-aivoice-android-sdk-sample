    <!-- Module 6 · Cloud sync -->
    <string name="native_cloud_title">Module 6 · Cloud sync</string>
    <string name="native_cloud_hint">Status comes from two sources: a snapshot fetched once via getCloudSyncSwitchStatus on entry, then incremental updates from SyncObserver. The mini program\'s onFileListUpdateStatusEvent is synthesised by the container; Native has no such event channel, so the snapshot rides along with the switch query and the increments must be aggregated by hand.</string>
    <string name="native_cloud_switch_section">Cloud sync switch</string>
    <string name="native_cloud_switch_hint">Writing the switch is NOT a TTT SDK capability: the mini program calls the atop API m.wearable.sync.switch.save directly, and the SDK only offers a getter. The API is a full submit — enabled and syncType must both be sent every time.</string>
    <string name="native_cloud_switch_enabled">Enable cloud sync</string>
    <string name="native_cloud_switch_wifi_only">Sync over Wi-Fi only</string>
    <string name="native_cloud_switch_empty">Not queried yet</string>
    <string name="native_cloud_btn_query_switch">Query switch status and sync snapshot</string>
    <string name="native_cloud_aggregate_section">Aggregated sync status</string>
    <string name="native_cloud_aggregate_hint">Status is driven by uploads only; downloads do not affect it (matching the underlying implementation) and are shown as counters. The underlying IDLE state (never synced) also maps to "Synced". Note that downloadError / downloadSuccess still mean "downloading" — only onFinish is a real end.</string>
