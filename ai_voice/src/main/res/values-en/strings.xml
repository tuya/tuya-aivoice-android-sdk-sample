    <!-- More Native capabilities -->
    <string name="native_more_entry">More</string>
    <string name="native_api_list_title">More Native Capabilities</string>
    <string name="native_api_list_hint">Pages below follow the module split in wearkit-ttt-native-api.md. Each demonstrates one module end to end, including listener registration and removal. Recording control and device ability live in "Native Record"; file management and transcription live in "Record List".</string>
    <string name="native_api_entry_offline_title">Module 4 · Offline file transfer</string>
    <string name="native_api_entry_offline_desc">Download recordings cached on the device, over BLE or AP fast transfer</string>
    <string name="native_api_entry_offline_api">getDeviceOfflineFileStatus / loadOfflineFile / switchModeLoadOfflineFile / registerFileProgressCallback</string>
    <string name="native_api_entry_import_title">Module 5 · Audio import</string>
    <string name="native_api_entry_import_desc">Import local audio as recordings; the picker result must be fed back in onActivityResult</string>
    <string name="native_api_entry_import_api">startImport / retryImport / cancelImport / cancelRetry / handleImportActivityResult</string>
    <string name="native_api_entry_cloud_title">Module 6 · Cloud sync</string>
    <string name="native_api_entry_cloud_desc">Sync switch plus aggregated upload/download status; Native must aggregate SyncObserver callbacks itself</string>
    <string name="native_api_entry_cloud_api">getCloudSyncSwitchStatus / syncNoteRecord / addAudioSyncObserver / addCloudSwitchListener</string>
    <string name="native_api_entry_merge_title">Module 8 · Merge recordings</string>
    <string name="native_api_entry_merge_desc">Merge several recordings in the chosen order; order defines audio concatenation</string>
    <string name="native_api_entry_merge_api">mergeRecordList / cancelMergeRecordList / getFileMergeStatus / addMergeStatusListener</string>
    <string name="native_api_entry_quick_title">Module 9 · Quick entries</string>
    <string name="native_api_entry_quick_desc">Query and toggle widgets, shortcuts and tiles</string>
    <string name="native_api_entry_quick_api">getQuickEntryList / setQuickEntryEnabled / addQuickEntryAddListener</string>
    <string name="native_api_entry_translate_title">Module 10 · Text translation (not implemented)</string>
    <string name="native_api_entry_translate_desc">Belongs to the AI Translate business (businessType=1) and is unused by the AI Note mini program, so it is out of scope for this demo</string>
    <string name="native_api_entry_translate_api">startTranslate / getTranslateFileList / sendToNote / batchRemoveTranslationFiles</string>

